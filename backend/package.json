{
  "name": "lex-probe-backend",
  "version": "1.0.0",
  "description": "Backend for the Lex Probe Legal Intelligence Platform",
  "main": "dist/app.js",
  "scripts": {
    "start": "node init && node dist/app.js",
    "dev": "node init && ts-node -r tsconfig-paths/register src/app.ts",
    "build": "node init && npm run clean && tsc && tsc-alias",
    "build:watch": "node init && tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "db:seed": "ts-node -r tsconfig-paths/register src/scripts/seedDatabase.ts",
    "db:reset": "ts-node -r tsconfig-paths/register src/scripts/resetDatabase.ts"
  },
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.1.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.4",
    "openai": "^5.11.0",
    "puppeteer": "^24.15.0",
    "redis": "^4.6.8",
    "serpapi": "^2.2.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^2.1.2",
    "@types/axios": "^0.14.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.5.0",
    "@types/nodemailer": "^6.4.9",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
