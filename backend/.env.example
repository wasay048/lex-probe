# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/cartel-detection-platform
MONGODB_TEST_URI=mongodb://localhost:27017/cartel-detection-platform-test

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=


# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@carteldetection.com

# reCAPTCHA Configuration
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Keys (for future use)
OPENAI_API_KEY=your-openai-api-key
SERPAPI_KEY=your-serpapi-key
FACTIVA_API_KEY=your-factiva-api-key

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000